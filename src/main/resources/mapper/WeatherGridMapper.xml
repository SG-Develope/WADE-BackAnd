<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wade.wadeapi.mapper.WeatherGridMapper">

    <resultMap id="weatherGridMap" type="com.wade.wadeapi.domain.WeatherGrid">
        <id     property="stationId" column="station_id"/>
        <result property="nx"        column="nx"/>
        <result property="ny"        column="ny"/>
    </resultMap>

    <select id="findAll" resultMap="weatherGridMap">
        SELECT station_id, nx, ny
        FROM weather_grid
        ORDER BY station_id
    </select>

    <select id="findByStationId" parameterType="String" resultMap="weatherGridMap">
        SELECT station_id, nx, ny
        FROM weather_grid
        WHERE station_id = #{stationId}
    </select>

</mapper>
